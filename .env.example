# Configuration for the live examples. Copy this file to .env (git-ignored), fill it in, and
# load it in your shell. Never commit real credentials.
OPENAI_API_KEY=<your-api-key>
BEHAVIORWEAVE_MODEL=<chat-model-name>
# Optional: any OpenAI-compatible endpoint. Leave commented out to use api.openai.com.
# OPENAI_BASE_URL=https://your-endpoint.example/v1
